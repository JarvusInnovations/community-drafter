# Copy to apps/api/.env for local development. See specs/architecture.md →
# Deployment → Configuration for the authoritative list; apps/api's
# @fastify/env schema (apps/api/src/plugins/env.ts) declares the same names.

# --- Fastify basics (not in specs/architecture.md; @fastify/env defaults) ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Data repository: the private git repo of gitsheets records ---
DATA_REPO_URL=                  # e.g. git@github.com:org/community-drafter-data.git
DATA_REPO_BRANCH=               # e.g. main
DATA_REPO_WEBHOOK_SECRET=       # HMAC secret for the POST /admin/api/refresh webhook (X-Hub-Signature-256)

# --- Public identity ---
PUBLIC_URL=                     # e.g. https://drafter.example.org

# --- Operator auth (specs/behaviors/operators.md) ---
AUTH_SECRET=                    # signs operator sessions, CLI tokens and magic links; required in production, >=32 bytes
BOOTSTRAP_OPERATOR_EMAIL=       # creates the first operator when the operators sheet is empty at boot; ignored otherwise
DEV_ADMIN_EMAIL=                # local/test only: bypasses magic-link sign-in entirely; ignored when NODE_ENV=production
AUTH_LOGIN_RATE_LIMIT=5          # sign-in requests allowed per address and per source IP per 15 minutes

# --- Outbound messaging ---
MAILER=export                   # postmark | smtp | export
POSTMARK_API_KEY=               # used when MAILER=postmark (X-Postmark-Server-Token)
SMTP_HOST=                      # used when MAILER=smtp
SMTP_PORT=                      # used when MAILER=smtp (465 = implicit TLS)
SMTP_USER=                      # used when MAILER=smtp
SMTP_PASSWORD=                  # used when MAILER=smtp
EXPORT_CSV_PATH=                # used when MAILER=export; appends name,email,subject,link rows

# --- Instance identity ---
INSTANCE_NAME=                  # e.g. "Save the Academy Coalition"
INSTANCE_FROM_EMAIL=            # From: address for outbound notifications
INSTANCE_TIMEZONE=              # e.g. America/New_York — governs the daily digest hour
INSTANCE_DIGEST_HOUR=8          # 0-23, local to INSTANCE_TIMEZONE; daily digest send hour
