{
  "name": "@community-drafter/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint src scripts",
    "format": "oxfmt src scripts",
    "format:check": "oxfmt --check src scripts",
    "typecheck": "tsc -b",
    "build:cli": "bun scripts/build-cli.ts",
    "build:skill": "bun scripts/build-skill.ts",
    "build": "bun run build:cli && bun run build:skill",
    "test": "bun test"
  },
  "devDependencies": {
    "@toon-format/toon": "2.3.0",
    "@types/node": "^26.6.2",
    "axi-sdk-js": "0.1.7",
    "esbuild": "0.28.0"
  }
}
